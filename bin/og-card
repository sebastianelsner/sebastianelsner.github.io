#!/usr/bin/env python3
"""Generate a per-post OG card PNG.

Usage: bin/og-card "Post Title" slug "Month DD, YYYY"

Produces: assets/img/og-<slug>.png  (1200x630)

Requires inkscape on PATH. Reads no other dependencies.
"""
import subprocess
import sys
import textwrap
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
ASSETS = ROOT / "assets" / "img"

TEMPLATE = """<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <defs>
    <style>
      .paper {{ fill: #f4efe6; }}
      .ink {{ fill: #1a1814; }}
      .ink-soft {{ fill: #4a463e; }}
      .ink-faint {{ fill: #736d62; }}
      .amber {{ fill: #b8732a; }}
      .site {{ font-family: 'JetBrains Mono', 'DejaVu Sans Mono', monospace; font-weight: 700; font-size: 22px; letter-spacing: 1.4px; text-transform: uppercase; }}
      .title {{ font-family: 'JetBrains Mono', 'DejaVu Sans Mono', monospace; font-weight: 700; font-size: 56px; letter-spacing: -1.5px; }}
      .author {{ font-family: 'JetBrains Mono', 'DejaVu Sans Mono', monospace; font-weight: 500; font-size: 24px; letter-spacing: -0.2px; }}
      .pillars {{ font-family: 'JetBrains Mono', 'DejaVu Sans Mono', monospace; font-weight: 700; font-size: 24px; letter-spacing: 1.2px; text-transform: uppercase; }}
    </style>
  </defs>
  <rect width="1200" height="630" class="paper"/>
  <line x1="80" y1="80" x2="1120" y2="80" stroke="#d8cfb8" stroke-width="1" stroke-dasharray="2 4"/>
  <text x="80" y="140" class="site"><tspan class="amber">##</tspan>  <tspan class="ink">SEBASTIANELSNER.DE</tspan>  <tspan class="ink-faint">/BLOG</tspan></text>
  <text class="title ink">
{title_lines}
  </text>
  <text x="80" y="490" class="author ink-soft"><tspan class="amber">›</tspan> Sebastian Elsner  <tspan class="ink-faint">·</tspan>  {date}</text>
  <text x="80" y="540" class="pillars ink"><tspan class="amber">##</tspan>  Software <tspan class="amber">·</tspan> VFX Pipelines <tspan class="amber">·</tspan> DevOps <tspan class="amber">·</tspan> ML</text>
  <line x1="80" y1="570" x2="1120" y2="570" stroke="#d8cfb8" stroke-width="1" stroke-dasharray="2 4"/>
</svg>
"""


def escape(s: str) -> str:
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def wrap_title(title: str, width: int = 32, max_lines: int = 3) -> list[str]:
    lines = textwrap.wrap(title, width=width, break_long_words=False)
    if len(lines) > max_lines:
        # collapse trailing lines into the last allowed one
        head = lines[: max_lines - 1]
        tail = " ".join(lines[max_lines - 1 :])
        lines = head + [tail]
    return lines


def render_title_lines(lines: list[str]) -> str:
    line_h = 68
    n = len(lines)
    # vertically centre the title block around y=320
    y_first = 320 - (n - 1) * (line_h / 2)
    out = []
    for i, line in enumerate(lines):
        if i == 0:
            out.append(f'    <tspan x="80" y="{y_first:.0f}">{escape(line)}</tspan>')
        else:
            out.append(f'    <tspan x="80" dy="{line_h}">{escape(line)}</tspan>')
    return "\n".join(out)


def main() -> int:
    if len(sys.argv) != 4:
        print('usage: bin/og-card "Title" slug "Month DD, YYYY"', file=sys.stderr)
        return 1

    title, slug, date = sys.argv[1], sys.argv[2], sys.argv[3]

    lines = wrap_title(title)
    svg = TEMPLATE.format(title_lines=render_title_lines(lines), date=escape(date))

    svg_tmp = Path(f"/tmp/og-{slug}.svg")
    svg_tmp.write_text(svg)

    out = ASSETS / f"og-{slug}.png"
    subprocess.run(
        [
            "inkscape",
            str(svg_tmp),
            "--export-type=png",
            f"--export-filename={out}",
            "--export-width=1200",
            "--export-height=630",
        ],
        check=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    print(f"wrote {out}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
